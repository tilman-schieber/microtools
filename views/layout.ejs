<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('_head', { title: typeof title !== 'undefined' ? title : 'Microtools' }) %>
</head>
<body<% if (typeof bodyClass !== 'undefined' && bodyClass) { %> class="<%= bodyClass %>"<% } %>>
