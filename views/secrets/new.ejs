<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../_head', { title: title }) %>
</head>
<body>
  <%- include('../_header', { crumb: t('crumb.secret') }) %>
  <main>
    <h1><%- t('secrets.new.title') %></h1>
    <p class="hint"><%- t('secrets.new.hint') %></p>
    
    <form id="secret-form">
      <label for="secret-text"><%- t('secrets.new.label') %></label>
      <textarea name="text" id="secret-text" rows="6" placeholder="<%- t('secrets.new.placeholder') %>" required></textarea>
      
      <button type="submit"><%- t('secrets.new.submit') %></button>
    </form>
    
    <div id="result"></div>
  </main>

  <script>
    const subtle = globalThis.crypto && globalThis.crypto.subtle;

    // Generate a random 256-bit key
    async function generateKey() {
      if (!subtle) {
        throw new Error(T.noCrypto);
      }
      return await subtle.generateKey(
        { name: 'AES-GCM', length: 256 },
        true,
        ['encrypt', 'decrypt']
      );
    }

    // Export key to base64url
    async function exportKey(key) {
      const raw = await crypto.subtle.exportKey('raw', key);
      return btoa(String.fromCharCode(...new Uint8Array(raw)))
        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Encrypt plaintext with key, returns base64url ciphertext
    async function encrypt(plaintext, key) {
      if (!subtle) {
        throw new Error(T.noCrypto);
      }
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const encoded = new TextEncoder().encode(plaintext);
      const ciphertext = await subtle.encrypt(
        { name: 'AES-GCM', iv },
        key,
        encoded
      );
      // Prepend IV to ciphertext
      const combined = new Uint8Array(iv.length + ciphertext.byteLength);
      combined.set(iv);
      combined.set(new Uint8Array(ciphertext), iv.length);
      return btoa(String.fromCharCode(...combined))
        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    document.getElementById('secret-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = document.getElementById('secret-text').value;
      const resultDiv = document.getElementById('result');
      
      if (!text.trim()) {
        resultDiv.innerHTML = '<p class="error"></p>'; resultDiv.firstChild.textContent = T.secretEmpty;
        return;
      }

      try {
        // Generate key and encrypt client-side
        const key = await generateKey();
        const keyStr = await exportKey(key);
        const ciphertext = await encrypt(text, key);

        // Send only ciphertext to server
        const response = await fetch('/secrets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'ciphertext=' + encodeURIComponent(ciphertext)
        });

        const html = await response.text();
        // Extract the ID from response and append key as fragment
        const match = html.match(/\/secrets\/([^"#]+)/);
        if (match) {
          const secretId = match[1];
          const fullUrl = location.origin + '/secrets/' + secretId + '#' + keyStr;
          resultDiv.innerHTML =
            '<p></p><p><a></a></p>' +
            '<button class="copy-btn" id="copy-secret-btn"></button>' +
            '<div class="qrcode"></div>' +
            '<p class="hint"></p>';
          resultDiv.children[0].textContent = T.secretCreated;
          const link = resultDiv.querySelector('a');
          link.href = fullUrl;
          link.textContent = fullUrl;
          resultDiv.querySelector('.qrcode').dataset.url = fullUrl;
          resultDiv.querySelector('.hint').textContent = T.secretKeyHint;
          const copyBtn = document.getElementById('copy-secret-btn');
          copyBtn.textContent = T.copyLink;
          copyBtn.addEventListener('click', function() {
            navigator.clipboard.writeText(fullUrl);
            this.textContent = T.copied;
          });
          renderQRCodes(resultDiv);
        } else {
          resultDiv.innerHTML = html;
        }
      } catch (err) {
        resultDiv.innerHTML = '<p class="error"></p>'; resultDiv.firstChild.textContent = T.encryptFailed + err.message;
      }
    });
  </script>
</body>
</html>
