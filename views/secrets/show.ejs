<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../_head', { title: title }) %>
  <meta name="robots" content="noindex">
</head>
<body>
  <%- include('../_header', { crumb: t('crumb.secret'), noLangSwitch: true }) %>
  <main>
    <h1><%- t('secrets.show.title') %></h1>
    <div id="secret-container">
      <div id="prompt">
        <p><%- t('secrets.show.intro') %></p>
        <div class="actions"><button type="button" id="reveal-btn"><%- t('secrets.show.reveal') %></button></div>
      </div>
      <p id="loading" style="display: none;"><%- t('secrets.show.loading') %></p>
      <div id="decrypted" style="display: none;">
        <pre id="secret-text" class="note-text"></pre>
        <p class="hint"><%- t('secrets.show.deletedHint') %></p>
      </div>
      <div id="error" class="error" style="display: none;"></div>
    </div>
  </main>

  <script>
    // The page itself never contains the ciphertext. Link scanners (Outlook
    // Safe Links, Teams previews) load this page, but only the button click
    // fetches the secret, and that fetch deletes it on the server.
    const secretId = <%- JSON.stringify(secretId) %>;
    const subtle = globalThis.crypto && globalThis.crypto.subtle;

    function b64urlToBytes(s) {
      let b64 = s.replace(/-/g, '+').replace(/_/g, '/');
      while (b64.length % 4) b64 += '=';
      return Uint8Array.from(atob(b64), c => c.charCodeAt(0));
    }

    function bytesToB64url(bytes) {
      return btoa(String.fromCharCode(...bytes))
        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    async function decrypt(ciphertextB64, rawKey) {
      const key = await subtle.importKey(
        'raw',
        rawKey,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
      const combined = b64urlToBytes(ciphertextB64);
      const iv = combined.slice(0, 12);
      const data = combined.slice(12);
      const decrypted = await subtle.decrypt({ name: 'AES-GCM', iv }, key, data);
      return new TextDecoder().decode(decrypted);
    }

    const promptEl = document.getElementById('prompt');
    const revealBtn = document.getElementById('reveal-btn');
    const loadingEl = document.getElementById('loading');
    const decryptedEl = document.getElementById('decrypted');
    const secretTextEl = document.getElementById('secret-text');
    const errorEl = document.getElementById('error');

    function showError(msg) {
      promptEl.style.display = 'none';
      loadingEl.style.display = 'none';
      errorEl.style.display = 'block';
      errorEl.textContent = msg;
    }

    const keyStr = location.hash.slice(1);
    if (!keyStr) {
      showError(T.missingKey);
    } else if (!subtle) {
      showError(T.noCrypto);
    }

    revealBtn.addEventListener('click', async () => {
      revealBtn.disabled = true;
      let rawKey;
      try {
        rawKey = b64urlToBytes(keyStr);
      } catch (err) {
        showError(T.missingKey);
        return;
      }

      promptEl.style.display = 'none';
      loadingEl.style.display = 'block';

      let ciphertext;
      try {
        const keyHash = bytesToB64url(new Uint8Array(await subtle.digest('SHA-256', rawKey)));
        const res = await fetch('/secrets/' + encodeURIComponent(secretId) + '/reveal', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ keyHash })
        });
        const body = await res.json().catch(() => ({}));
        if (res.status === 404) return showError(T.secretGone);
        if (res.status === 403) return showError(T.secretWrongKey);
        if (!res.ok || !body.ciphertext) return showError(T.revealFailed + res.status);
        ciphertext = body.ciphertext;
      } catch (err) {
        return showError(T.revealFailed + err.message);
      }

      try {
        secretTextEl.textContent = await decrypt(ciphertext, rawKey);
        loadingEl.style.display = 'none';
        decryptedEl.style.display = 'block';
      } catch (err) {
        showError(T.decryptFailed + err.message);
      }
    });
  </script>
</body>
</html>
