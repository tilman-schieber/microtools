<% const content = `
  <main class="test-tool test-microphone">
    <h1>${t('test.microphone.name')}</h1>
    <p class="tagline">${t('test.microphone.tagline')}</p>

    <section class="test-panel">
      <div class="test-controls">
        <button type="button" id="mic-start">${t('test.microphone.start')}</button>
        <button type="button" id="mic-stop" class="btn-secondary" hidden>${t('test.stop')}</button>
        <div class="test-field">
          <label for="mic-device">${t('test.microphone.device')}</label>
          <select id="mic-device"><option value="">${t('test.defaultDevice')}</option></select>
        </div>
      </div>
      <div class="test-controls">
        <label class="checkbox-option"><input type="checkbox" id="mic-ec" checked> ${t('test.microphone.echo')}</label>
        <label class="checkbox-option"><input type="checkbox" id="mic-ns" checked> ${t('test.microphone.noise')}</label>
        <label class="checkbox-option"><input type="checkbox" id="mic-agc" checked> ${t('test.microphone.agc')}</label>
      </div>
      <p id="mic-error" class="error" hidden></p>

      <div class="meter" aria-hidden="true">
        <div class="meter-cover" id="mic-meter"></div>
        <div class="meter-peak" id="mic-peak" style="left: -10px"></div>
      </div>
      <div class="meter-scale" aria-hidden="true"><span>-60 dB</span><span>-40</span><span>-20</span><span>0 dB</span></div>
      <p class="mic-level"><span id="mic-level">—</span> <span id="mic-clip" class="mic-clip" hidden>${t('test.microphone.clipping')}</span></p>
      <p id="mic-silent" class="hint" hidden>${t('test.microphone.silent')}</p>

      <div class="test-tabs" role="tablist">
        <button type="button" class="btn-secondary btn-sm password-tab is-active" data-view="wave" role="tab" aria-selected="true">${t('test.microphone.waveform')}</button>
        <button type="button" class="btn-secondary btn-sm password-tab" data-view="spectrum" role="tab" aria-selected="false">${t('test.microphone.spectrum')}</button>
      </div>
      <canvas class="scope" id="mic-scope"></canvas>
    </section>

    <section class="test-panel">
      <h2>${t('test.microphone.recordHeading')}</h2>
      <p class="hint">${t('test.microphone.recordHint')}</p>
      <div class="test-controls">
        <button type="button" id="mic-record" class="btn-secondary" disabled>${t('test.microphone.record')}</button>
      </div>
      <audio id="mic-playback" controls hidden></audio>
    </section>

    <dl class="test-stats">
      <div><dt>${t('test.microphone.statDevice')}</dt><dd id="mic-stat-device">—</dd></div>
      <div><dt>${t('test.microphone.statRate')}</dt><dd id="mic-stat-rate">—</dd></div>
      <div><dt>${t('test.microphone.statChannels')}</dt><dd id="mic-stat-channels">—</dd></div>
      <div><dt>${t('test.microphone.statProcessing')}</dt><dd id="mic-stat-processing">—</dd></div>
    </dl>
  </main>

  <script src="/public/test/media.js"></script>
  <script src="/public/test/microphone.js"></script>
` %>
<%- include('../layout', { content, title, crumb: t('test.microphone.name'), crumbParent: { href: '/test', label: t('crumb.test') } }) %>
