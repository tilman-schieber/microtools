<%
// groups comes from server/tools: each category with its tools, in display order
const arrow = '<svg class="tool-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';

const sections = groups.map(g => `
    <section class="tool-group" aria-labelledby="group-${g.category}">
      <h2 class="tool-group-head" id="group-${g.category}">${t('landing.group.' + g.category)}<span class="tool-group-note">${t('landing.group.' + g.category + '.note')}</span></h2>
      <ul class="tool-list">${g.tools.map(tool => `
        <li>
          <a href="${tool.href}" class="tool-row">
            <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${tool.icon}</svg>
            <span class="tool-text">
              <span class="tool-name">${t('tool.' + tool.id + '.name')}</span>
              <span class="tool-desc">${t('tool.' + tool.id + '.desc')}</span>
            </span>
            ${arrow}
          </a>
        </li>`).join('')}
      </ul>
    </section>`).join('');

// Names and icons for the quick links, which public/recent.js draws from localStorage.
// Escaped for a <script> block: no tool name or icon may close it early.
const toolMeta = {};
groups.forEach(g => g.tools.forEach(tool => { toolMeta[tool.id] = { name: plain(t('tool.' + tool.id + '.name')), icon: tool.icon }; }));
const toolMetaJson = JSON.stringify(toolMeta).replace(/</g, '\\u003c');

const recent = `
    <section class="tool-group recent-links" id="recent" aria-labelledby="group-recent" hidden>
      <h2 class="tool-group-head" id="group-recent">${t('landing.recent')}<span class="tool-group-note">${t('landing.recent.note')}</span></h2>
      <ul class="tool-list"></ul>
      <button type="button" class="btn-link recent-clear">${t('landing.recent.clear')}</button>
    </section>
    <script type="application/json" id="tool-meta">${toolMetaJson}</script>`;

const content = `
  <main class="landing">
    <div class="landing-hero">
      <h1>${t('landing.title')}</h1>
      <p>${t('landing.lead')}</p>
    </div>${recent}${sections}
    <p class="landing-footer">${t('landing.footer')}</p>
  </main>
` %>
<%- include('layout', { content, title, bodyClass: 'landing-page' }) %>
