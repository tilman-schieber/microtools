<% const content = `
  <main class="clock-tool">
    <h1>${t('micropage.title')}</h1>
    <p class="tagline">${t('micropage.tagline')}</p>

    <form id="micropage-form" class="clock-config-form">
      <div class="password-options-grid">
        <fieldset class="password-fieldset">
          <legend>${t('micropage.layout')}</legend>

          <label for="mp-template">${t('micropage.template')}</label>
          <select id="mp-template"></select>
          <p id="mp-template-hint" class="hint"></p>

          <label for="mp-theme">${t('micropage.theme')}</label>
          <select id="mp-theme"></select>

          <label for="mp-width">${t('micropage.width')}</label>
          <select id="mp-width"></select>

          <label for="mp-lang">${t('micropage.pageLang')}</label>
          <select id="mp-lang">
            <option value="en"${lang === 'de' ? '' : ' selected'}>English</option>
            <option value="de"${lang === 'de' ? ' selected' : ''}>Deutsch</option>
          </select>

          <label>${t('micropage.accent')}</label>
          <div id="mp-accents" class="micropage-swatches"></div>

          <label class="checkbox-option"><input type="checkbox" id="mp-flag-c"> ${t('micropage.centre')}</label>
          <label class="checkbox-option"><input type="checkbox" id="mp-flag-b"> ${t('micropage.bigger')}</label>
        </fieldset>

        <fieldset class="password-fieldset">
          <legend>${t('micropage.content')}</legend>
          <div id="mp-slots" class="micropage-slots"></div>
          <p class="hint">${t('micropage.slotsHint')}</p>
        </fieldset>
      </div>
    </form>

    <section class="password-output">
      <label for="mp-link">${t('micropage.pageLink')}</label>
      <input type="text" id="mp-link" readonly>

      <div class="password-actions">
        <button type="button" id="mp-copy" class="copy-btn">${t('common.copy')}</button>
        <a id="mp-open" class="download-btn clock-open-link" href="#" target="_blank" rel="noopener noreferrer" hidden>${t('micropage.open')}</a>
      </div>

      <p id="mp-meta" class="hint"></p>
      <p id="mp-error" class="error" hidden></p>

      <div class="qrcode" id="mp-qr"></div>

      <label for="mp-preview">${t('micropage.preview')}</label>
      <iframe id="mp-preview" class="micropage-preview" title="${t('micropage.previewTitle')}"></iframe>
    </section>

    <p><a href="/micropage/docs">${t('micropage.readDocs')}</a></p>
  </main>

  <script src="/public/micropage-config.js"></script>
` %>
<%- include('../layout', { content, title, crumb: t('crumb.micropage') }) %>
