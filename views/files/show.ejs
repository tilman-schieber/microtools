<%
const fileList = share.data.files || [];
const isSingle = fileList.length === 1;
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../_head', { title: title }) %>
</head>
<body>
  <%- include('../_header', { crumb: t('crumb.files') }) %>
  <main>
    <h1><%- t('files.show.title') %></h1>
    <% if (isSingle) { %>
      <div class="file-download">
        <p><%- t('files.show.downloadYour') %></p>
        <a href="/files/<%= share.id %>/download/<%= encodeURIComponent(fileList[0].name) %>" class="download-btn">
          <%= fileList[0].name %> (<%= fileList[0].sizeFormatted %>)
        </a>
      </div>
    <% } else { %>
      <div class="file-listing">
        <p><%- tn('files.shared', fileList.length) %></p>
        <ul class="file-list">
          <% fileList.forEach(file => { %>
            <li>
              <a href="/files/<%= share.id %>/download/<%= encodeURIComponent(file.name) %>"><%= file.name %></a>
              <span class="file-size">(<%= file.sizeFormatted %>)</span>
            </li>
          <% }); %>
        </ul>
        <a href="/files/<%= share.id %>/zip" class="download-btn"><%- t('files.show.downloadZip') %></a>
      </div>
    <% } %>

    <% if (share.expires_at) { %>
      <p class="hint"><%- t('files.show.expiresOn', { date: fmtDate(share.expires_at, 'long') }) %></p>
    <% } %>

    <div class="share-link">
      <p><%- t('common.shareThisLink') %></p>
      <p><a href="<%= shareUrl %>"><%= shareUrl %></a></p>
      <div class="qrcode" data-url="<%= shareUrl %>"></div>
    </div>

    <div class="file-actions">
      <button hx-delete="/files/<%= share.id %>" hx-target="#delete-result" hx-swap="innerHTML" hx-confirm="<%- t('files.show.deleteConfirm') %>"><%- t('files.show.delete') %></button>
      <div id="delete-result"></div>
    </div>

  </main>
</body>
</html>
