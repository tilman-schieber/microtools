<% const content = `
  <main>
    <h1>${t('files.new.title')}</h1>
    <p class="hint">${t('files.new.hint')} ${t('files.new.limit', { mb: limitMb })}</p>
    
    <form id="file-form" enctype="multipart/form-data">
      <label for="file-input">${t('files.new.selectLabel')}</label>
      <input type="file" name="files" id="file-input" multiple required>
      
      <div id="file-list" class="file-list"></div>
      
      <label for="expiry-select">${t('files.new.expiresLabel')}</label>
      <select id="expiry-select" name="expiry">
        <option value="1">${tn('files.option', 1)}</option>
        <option value="3" selected>${tn('files.option', 3)}</option>
        <option value="7">${tn('files.option', 7)}</option>
        <option value="30">${tn('files.option', 30)}</option>
      </select>
      
      <button type="submit">${t('files.new.submit')}</button>
    </form>
    
    <div id="result"></div>
  </main>

  <script>
    const fileInput = document.getElementById('file-input');
    const fileList = document.getElementById('file-list');
    
    const LIMIT = ${limitMb} * 1024 * 1024;
    const totalSize = (files) => Array.from(files).reduce((sum, f) => sum + f.size, 0);
    const tooLargeMessage = (files) => tf('uploadTooLarge', { mb: ${limitMb}, size: formatSize(totalSize(files)) });

    fileInput.addEventListener('change', () => {
      fileList.innerHTML = '';
      const files = fileInput.files;
      if (totalSize(files) > LIMIT) {
        const p = document.createElement('p');
        p.className = 'error';
        p.textContent = tooLargeMessage(files);
        fileList.appendChild(p);
      }
      if (files.length > 0) {
        const ul = document.createElement('ul');
        for (const file of files) {
          const li = document.createElement('li');
          li.textContent = file.name + ' (' + formatSize(file.size) + ')';
          ul.appendChild(li);
        }
        fileList.appendChild(ul);
      }
    });
    
    function formatSize(bytes) {
      // 1.5 MB in English, 1,5 MB in German
      const n = (v) => v.toLocaleString(document.documentElement.lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return n(bytes / 1024) + ' KB';
      return n(bytes / (1024 * 1024)) + ' MB';
    }

    document.getElementById('file-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const resultDiv = document.getElementById('result');
      const files = fileInput.files;
      
      if (files.length === 0) {
        resultDiv.innerHTML = '<p class="error"></p>'; resultDiv.firstChild.textContent = T.selectOneFile;
        return;
      }

      // Checked here so nobody waits for an upload that is bound to be refused
      if (totalSize(files) > LIMIT) {
        resultDiv.innerHTML = '<p class="error"></p>'; resultDiv.firstChild.textContent = tooLargeMessage(files);
        return;
      }

      const formData = new FormData();
      formData.append('expiry', document.getElementById('expiry-select').value);
      for (const file of files) {
        formData.append('files', file);
      }

      try {
        resultDiv.innerHTML = '<p></p>'; resultDiv.firstChild.textContent = T.uploading;
        const response = await fetch('/files', {
          method: 'POST',
          body: formData
        });
        // nginx answers an oversized request with its own bare 413 page; show ours instead
        if (response.status === 413) {
          resultDiv.innerHTML = '<p class="error"></p>'; resultDiv.firstChild.textContent = tooLargeMessage(files);
          return;
        }
        resultDiv.innerHTML = await response.text();
        renderQRCodes(resultDiv);
        rememberLinks(resultDiv);
      } catch (err) {
        resultDiv.innerHTML = '<p class="error"></p>'; resultDiv.firstChild.textContent = T.uploadFailed + err.message;
      }
    });
  </script>
` %>
<%- include('../layout', { content, title, crumb: t('crumb.files') }) %>
