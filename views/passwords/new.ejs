<% const content = `
  <main class="password-tool">
    <h1>${t('passwords.title')}</h1>
    <p class="tagline">${t('passwords.tagline')}</p>

    <section class="password-output">
      <label for="generated-password">${t('passwords.generated')}</label>
      <textarea id="generated-password" class="password-value" rows="3" readonly spellcheck="false"></textarea>

      <div class="password-actions">
        <button type="button" id="generate-password-btn">${t('passwords.generate')}</button>
        <button type="button" id="copy-password-btn" class="copy-btn">${t('common.copy')}</button>
      </div>

      <p id="password-meta" class="hint"></p>
      <p id="password-error" class="error" hidden></p>
    </section>

    <div class="password-tabs" role="tablist" aria-label="${t('passwords.modeLabel')}">
      <button type="button" class="password-tab is-active" data-tab="alphanumeric" role="tab" aria-selected="true" aria-controls="password-panel-alphanumeric" id="password-tab-alphanumeric">${t('passwords.tabAlpha')}</button>
      <button type="button" class="password-tab" data-tab="xkcd" role="tab" aria-selected="false" aria-controls="password-panel-xkcd" id="password-tab-xkcd">${t('passwords.tabXkcd')}</button>
    </div>

    <section id="password-panel-alphanumeric" class="password-panel" data-panel="alphanumeric" role="tabpanel" aria-labelledby="password-tab-alphanumeric">
      <h2>${t('passwords.tabAlpha')}</h2>

      <div class="password-field password-length-field">
        <label for="alpha-length">${t('passwords.length')}</label>
        <div class="password-length-controls">
          <input type="range" id="alpha-length-range" min="8" max="64" value="20">
          <input type="number" id="alpha-length" min="8" max="64" value="20">
        </div>
      </div>

      <div class="password-options-grid">
        <fieldset class="password-fieldset">
          <legend>${t('passwords.charsets')}</legend>
          <label class="checkbox-option"><input type="checkbox" id="alpha-lowercase" checked> ${t('passwords.lowercase')}</label>
          <label class="checkbox-option"><input type="checkbox" id="alpha-uppercase" checked> ${t('passwords.uppercase')}</label>
          <label class="checkbox-option"><input type="checkbox" id="alpha-digits" checked> ${t('passwords.numbers')}</label>
          <label class="checkbox-option"><input type="checkbox" id="alpha-symbols"> ${t('passwords.symbols')}</label>
        </fieldset>

        <fieldset class="password-fieldset">
          <legend>${t('passwords.options')}</legend>
          <label class="checkbox-option"><input type="checkbox" id="alpha-avoid-ambiguous" checked> ${t('passwords.avoidAmbiguous')}</label>
          <label class="checkbox-option"><input type="checkbox" id="alpha-require-each" checked> ${t('passwords.requireEach')}</label>
          <label class="checkbox-option"><input type="checkbox" id="alpha-unique"> ${t('passwords.noRepeat')}</label>
        </fieldset>
      </div>

      <p class="hint">${t('passwords.symbolsHint')}</p>
    </section>

    <section id="password-panel-xkcd" class="password-panel" data-panel="xkcd" role="tabpanel" aria-labelledby="password-tab-xkcd" hidden>
      <h2>${t('passwords.xkcdHeading')}</h2>

      <div class="password-options-grid">
        <div class="password-field">
          <label for="xkcd-language">${t('passwords.language')}</label>
          <select id="xkcd-language">
            <option value="en"${lang === 'de' ? '' : ' selected'}>English</option>
            <option value="de"${lang === 'de' ? ' selected' : ''}>Deutsch</option>
          </select>
        </div>

        <div class="password-field">
          <label for="xkcd-word-count">${t('passwords.words')}</label>
          <input type="number" id="xkcd-word-count" min="3" max="8" value="5">
        </div>

        <div class="password-field">
          <label for="xkcd-separator">${t('passwords.separator')}</label>
          <select id="xkcd-separator">
            <option value="-" selected>${t('passwords.hyphen')}</option>
            <option value=" ">${t('passwords.space')}</option>
            <option value=".">${t('passwords.dot')}</option>
          </select>
        </div>

        <fieldset class="password-fieldset">
          <legend>${t('passwords.options')}</legend>
          <label class="checkbox-option"><input type="checkbox" id="xkcd-capitalize"> ${t('passwords.capitalize')}</label>
          <label class="checkbox-option"><input type="checkbox" id="xkcd-unique" checked> ${t('passwords.avoidRepeatWords')}</label>
        </fieldset>
      </div>

      <p class="hint">${t('passwords.xkcdHint')}</p>
    </section>

  </main>

  <script src="/public/password-words.js"></script>
  <script src="/public/passwords.js"></script>
` %>
<%- include('../layout', { content, title, crumb: t('crumb.passwords') }) %>
