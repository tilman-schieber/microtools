<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../_head', { title: bringlist.data.title }) %>
</head>
<body>
  <%- include('../_header', { crumb: t('crumb.potluck') }) %>
  <% if (typeof remember !== 'undefined' && remember) { %><%- include('../_remember', { remember }) %><% } %>
  <main>
    <h1><%= bringlist.data.title %></h1>
    <p class="hint"><%- t('bring.show.hint') %></p>

    <%# Filled by public/bring.js: the organiser's controls, and errors from claims %>
    <div id="bring-admin" class="bring-admin" hidden></div>
    <div id="bring-error" role="alert"></div>

    <div id="bringlist-content" data-list="<%= bringlist.id %>">
      <%- include('_list', { bringlist }) %>
    </div>

  </main>
  <script src="/public/bring.js"></script>
</body>
</html>
