<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { title: note.data.title || 'Note' }) %>
  <link rel="stylesheet" href="/public/highlight.min.css">
</head>
<body class="note-md-page">
  <%- include('../_header', { crumb: 'Note' }) %>
  <main>
    <h1><%= note.data.title || 'Note' %></h1>
    <div class="markdown-content">
      <%- renderedMarkdown %>
    </div>
    <div class="note-links">
      <a href="/notes/<%= note.id %>">View original</a>
      <a href="/notes/<%= note.id %>/raw">View raw</a>
    </div>
  </main>
</body>
</html>
