<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { title: note.data.title || 'Note' }) %>
</head>
<body>
  <%- include('../_header', { crumb: 'Note' }) %>
  <main>
    <h1><%= note.data.title || 'Note' %></h1>
    <div id="note-container">
      <pre class="note-text"><%= note.data.text || '' %></pre>
      <div class="note-links">
        <a href="/notes/<%= note.id %>/raw">View raw</a>
        <a href="/notes/<%= note.id %>/md">View as Markdown</a>
      </div>
      <button hx-delete="/notes/<%= note.id %>" hx-target="#note-container" hx-swap="innerHTML" hx-confirm="Delete this note?">Delete Note</button>
    </div>
  </main>
</body>
</html>
