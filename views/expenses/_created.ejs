<p><%- t('expenses.created') %></p>
<p><strong><%- t('expenses.summaryLink') %></strong> <a href="<%= summaryUrl %>"><%= summaryUrl %></a></p>
<div class="actions actions-tight"><button class="btn-secondary" data-url="<%= summaryUrl %>" onclick="navigator.clipboard.writeText(this.dataset.url);this.textContent=T.copied"><%- t('common.copyLink') %></button></div>
<div class="qrcode" data-url="<%= summaryUrl %>"></div>
<h3><%- t('expenses.participantLinks') %></h3>
<ul>
  <% links.forEach(function (p) { %>
  <li><strong><%= p.name %>:</strong> <a href="<%= p.url %>"><%= p.url %></a>
    <span class="inline-actions"><button class="btn-secondary btn-sm" data-url="<%= p.url %>" onclick="navigator.clipboard.writeText(this.dataset.url);this.textContent=T.copied"><%- t('common.copy') %></button>
    <button class="btn-secondary btn-sm" onclick="var d=this.nextElementSibling;d.hidden=!d.hidden;if(!d.hidden)renderQRCodes(d);"><%- t('common.qr') %></button></span>
    <div class="qrcode" data-url="<%= p.url %>" hidden></div></li>
  <% }); %>
</ul>
<% if (typeof hint !== 'undefined' && hint) { %><p class="hint"><%- hint %></p><% } %>
<% if (typeof remember !== 'undefined' && remember) { %><%- include('../_remember', { remember }) %><% } %>
