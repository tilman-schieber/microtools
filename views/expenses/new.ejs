<% const content = `
  <main>
    <h1>${t('expenses.new.title')}</h1>
    <form hx-post="/expenses" hx-target="#result" hx-swap="innerHTML">
      <label for="title">${t('expenses.new.titleLabel')}</label>
      <input type="text" name="title" id="title" placeholder="${t('expenses.new.titlePlaceholder')}" required>
      
      <label for="currency">${t('expenses.new.currency')}</label>
      <select name="currency" id="currency">
        <option value="€" selected>${t('expenses.currency.eur')}</option>
        <option value="$">${t('expenses.currency.usd')}</option>
        <option value="Fr.">${t('expenses.currency.chf')}</option>

      </select>
      
      <h3>${t('expenses.participants')}</h3>
      <p class="hint">${t('expenses.new.participantsHint')}</p>
      <div id="participants-container">
        <div class="participant-row">
          <input type="text" name="participants[]" placeholder="${t('expenses.new.namePlaceholder')}" required>
          <button type="button" onclick="this.parentElement.remove()">${t('common.remove')}</button>
        </div>
        <div class="participant-row">
          <input type="text" name="participants[]" placeholder="${t('expenses.new.namePlaceholder')}" required>
          <button type="button" onclick="this.parentElement.remove()">${t('common.remove')}</button>
        </div>
      </div>
      <button type="button" id="add-participant">${t('expenses.new.addParticipant')}</button>
      
      <br><br>
      <button type="submit">${t('expenses.new.title')}</button>
    </form>
    <div id="result"></div>
  </main>
  
  <script>
    document.getElementById('add-participant').addEventListener('click', function() {
      const container = document.getElementById('participants-container');
      const row = document.createElement('div');
      row.className = 'participant-row';
      row.innerHTML = '<input type="text" name="participants[]" required> <button type="button" onclick="this.parentElement.remove()"></button>';
      row.querySelector('input').placeholder = T.namePlaceholder;
      row.querySelector('button').textContent = T.remove;
      container.appendChild(row);
    });
  </script>
` %>
<%- include('../layout', { content, title, crumb: t('crumb.expenses') }) %>
