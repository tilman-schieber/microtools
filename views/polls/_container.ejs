<%
const slots = poll.data.slots || [];
const responses = poll.data.responses || [];

function formatDate(dateStr) {
  return fmtDate(dateStr, 'short');
}

function formatTime(timeStr) {
  return timeStr;
}

// An answer as an icon, with its word for screen readers
function voteMark(vote) {
  const kind = vote === 'yes' ? 'yes' : vote === 'tentative' ? 'maybe' : 'no';
  return icon(kind) + '<span class="sr-only">' + t('polls.vote.' + kind) + '</span>';
}
%>
<div id="poll-container" data-poll="<%= poll.id %>">
  <h2><%- t('polls.responses') %></h2>
  <div class="overflow-x-auto">
  <table class="poll-table">
    <thead>
      <tr>
        <th><%- t('polls.name') %></th>
        <% for (let i = 0; i < slots.length; i++) { %>
          <th><%- formatDate(slots[i].date) %><br><%- formatTime(slots[i].time) %></th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% if (responses.length === 0) { %>
        <tr><td colspan="<%= slots.length + 1 %>"><%- t('polls.noResponses') %></td></tr>
      <% } else { %>
        <% for (let r = 0; r < responses.length; r++) { %>
          <tr data-rid="<%= responses[r].id %>">
            <td><%= responses[r].name %></td>
            <% for (let i = 0; i < slots.length; i++) { %>
              <td class="vote-<%= responses[r].votes[i] || 'no' %>"><%- voteMark(responses[r].votes[i]) %></td>
            <% } %>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
  </div>
  
  <%# Filled in by public/polls.js when this browser holds the key to an answer %>
  <div id="poll-mine" class="poll-mine" hidden></div>

  <h3 id="poll-form-heading"><%- t('polls.addYours') %></h3>
  <form id="poll-form">
    <label for="name"><%- t('polls.yourName') %></label>
    <input type="text" name="name" id="name" placeholder="<%- t('polls.yourNamePlaceholder') %>" required maxlength="100" autocomplete="name">
    
    <p class="hint"><%- t('polls.voteHint') %>
      <span class="vote-legend"><span><%- icon('yes') %><%- t('polls.vote.yes') %></span><span><%- icon('maybe') %><%- t('polls.vote.maybe') %></span><span><%- icon('no') %><%- t('polls.vote.no') %></span></span>
    </p>
    
    <div class="overflow-x-auto">
    <table class="poll-table vote-grid">
      <thead>
        <tr>
          <% for (let i = 0; i < slots.length; i++) { %>
            <th><%- formatDate(slots[i].date) %><br><%- formatTime(slots[i].time) %></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <% for (let i = 0; i < slots.length; i++) { %>
            <td class="vote-cell vote-yes" data-index="<%= i %>">
              <span class="vote-emoji"><%- voteMark('yes') %></span>
              <input type="hidden" name="votes[]" value="yes">
            </td>
          <% } %>
        </tr>
      </tbody>
    </table>
    </div>
    
    <div id="poll-error"></div>
    <div class="actions">
      <button type="submit" id="poll-submit"><%- t('polls.submitResponse') %></button>
      <button type="button" id="poll-cancel" class="btn-secondary" hidden><%- t('polls.cancel') %></button>
    </div>
  </form>
</div>
